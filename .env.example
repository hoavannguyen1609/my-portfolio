# Sao chép thành .env rồi điền giá trị (không commit .env).
# scripts/set-env.mjs đọc file này + biến môi trường hệ thống (CI ghi đè .env)
# và sinh src/environments/env.generated.ts trước mỗi lần start/build.

# Tên môi trường: development | staging | production
NG_APP_ENV_NAME=development

# ---- Firebase (Project settings → Your apps → Web app → SDK config) ----
NG_APP_FIREBASE_API_KEY=
NG_APP_FIREBASE_AUTH_DOMAIN=
NG_APP_FIREBASE_PROJECT_ID=
NG_APP_FIREBASE_STORAGE_BUCKET=
NG_APP_FIREBASE_MESSAGING_SENDER_ID=
NG_APP_FIREBASE_APP_ID=
# Bắt buộc nếu bật Analytics (dạng G-XXXXXXXXXX)
NG_APP_FIREBASE_MEASUREMENT_ID=

# ---- App Check (reCAPTCHA v3 site key) – chặn bot ghi vào Firestore ----
NG_APP_RECAPTCHA_SITE_KEY=

# ---- Microsoft Clarity – heatmap & session replay (chỉ chạy khi người xem đồng ý) ----
NG_APP_CLARITY_PROJECT_ID=

# ---- Bật/tắt tính năng (true/false) ----
NG_APP_ENABLE_ANALYTICS=true
NG_APP_ENABLE_PERFORMANCE=true
NG_APP_ENABLE_REMOTE_CONFIG=true
NG_APP_ENABLE_CONTACT_FORM=true
