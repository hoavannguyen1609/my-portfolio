{
  "name": "nvh-portfolio",
  "version": "2.0.0",
  "description": "Portfolio cá nhân của Nguyễn Văn Hòa – Angular 21, Tailwind CSS 4, GSAP, Lenis. Deploy lên GitHub Pages.",
  "scripts": {
    "ng": "ng",
    "env": "node scripts/set-env.mjs",
    "env:check": "node scripts/set-env.mjs --strict",
    "prestart": "npm run env",
    "start": "ng serve",
    "prebuild": "npm run env",
    "build": "ng build",
    "build:gh": "node scripts/set-env.mjs --env-name production && ng build --base-href /my-portfolio/ && node scripts/postbuild-gh-pages.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "setup": "node scripts/setup.mjs",
    "publish:github": "node scripts/publish.mjs",
    "deploy:gh-pages": "npm run build:gh && gh-pages -d dist/nvh-portfolio/browser --dotfiles -m \"deploy: portfolio\"",
    "cv": "node cv/build-cv.mjs",
    "watch": "ng build --watch --configuration development"
  },
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@angular/common": "~21.2.24",
    "@angular/compiler": "~21.2.24",
    "@angular/core": "~21.2.24",
    "@angular/platform-browser": "~21.2.24",
    "@lucide/angular": "1.49.0",
    "firebase": "12.19.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "rxjs": "~7.8.0",
    "three": "0.186.1",
    "tslib": "^2.3.0",
    "web-vitals": "6.2.2"
  },
  "devDependencies": {
    "@angular/build": "~21.2.24",
    "@angular/cli": "~21.2.24",
    "@angular/compiler-cli": "~21.2.24",
    "@tailwindcss/postcss": "4.3.3",
    "@types/three": "0.186.0",
    "gh-pages": "6.3.0",
    "postcss": "8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.2"
  }
}
