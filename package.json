{
  "name": "nvh-portfolio",
  "version": "2.0.0",
  "description": "Portfolio cá nhân của Nguyễn Văn Hòa – Angular 21, Tailwind CSS 4, GSAP, Lenis. Deploy lên GitHub Pages.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:gh": "ng build --base-href /my-portfolio/ && node scripts/postbuild-gh-pages.mjs",
    "watch": "ng build --watch --configuration development"
  },
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@angular/common": "~21.2.24",
    "@angular/compiler": "~21.2.24",
    "@angular/core": "~21.2.24",
    "@angular/platform-browser": "~21.2.24",
    "@lucide/angular": "1.49.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "~21.2.24",
    "@angular/cli": "~21.2.24",
    "@angular/compiler-cli": "~21.2.24",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.2"
  }
}
